<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="vn.momo" />
        <package android:name="vn.momo.platform.test" /> <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:scheme="momo" />
    </intent>
    </queries>

    <application
        android:name=".AppointmentApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppointmentSchedulingApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AppointmentSchedulingApp">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent filter cho MoMo direct deeplink -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="appointmentschedulingapp"
                    android:host="momo"
                    android:path="/success" />
            </intent-filter>

            <!-- Intent filter cho MoMo redirect kết quả thanh toán -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="appointmentschedulingapp"
                    android:host="payment" />
            </intent-filter>

        </activity>

    </application>

</manifest>